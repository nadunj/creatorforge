---
interface Props {
  src?: string;
  alt: string;
  label: string;
  class?: string;
}

const { src, alt, label, class: className = 'h-40 w-full' } = Astro.props;
---

{src ? (
  <img src={src} alt={alt} class={`${className} object-cover`} loading="lazy" />
) : (
  <div class={`${className} flex items-center justify-center bg-gradient-to-br from-indigo-500 to-indigo-800`}>
    <span class="px-2 text-center text-xs font-bold uppercase tracking-widest text-white/80">{label}</span>
  </div>
)}
