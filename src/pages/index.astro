---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES } from '../lib/taxonomy';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = allArticles.slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CreatorForge',
  url: Astro.site,
  description:
    'AI tools, tutorials, and comparisons for YouTubers, Facebook and TikTok creators, designers, and small online businesses.',
};
---

<BaseLayout
  title="CreatorForge — AI Tools & Guides for Content Creators"
  description="Find the best AI tools for YouTube, TikTok, and Facebook creators: voice generators, image tools, video AI, and automation — with honest comparisons and pricing breakdowns."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-indigo-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        The AI toolkit for creators, decoded.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
        Honest guides, comparisons, and pricing breakdowns for the AI voice, video,
        image, and automation tools YouTubers, Facebook creators, and small online
        businesses actually use.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/tools/" class="rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500">
          Browse the Tool Directory
        </a>
        <a href="/guides/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
          Read the Guides
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="mb-6 text-2xl font-bold text-slate-900">Explore by category</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((cat) => (
        <a
          href={`/category/${cat.slug}/`}
          class="rounded-xl border border-slate-200 p-5 transition hover:border-indigo-300 hover:shadow-md"
        >
          <h3 class="mb-1 font-semibold text-slate-900">{cat.name}</h3>
          <p class="text-sm text-slate-600">{cat.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-slate-900">Latest articles</h2>
      <a href="/guides/" class="text-sm font-semibold text-indigo-600 hover:underline">View all →</a>
    </div>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
