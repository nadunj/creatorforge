---
import { getActiveNav } from '../lib/nav-data';
const { categories, contentTypes } = await getActiveNav();
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:grid-cols-4">
    <div>
      <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Categories</h3>
      <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
        {categories.map((cat) => (
          <li><a href={`/category/${cat.slug}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400">{cat.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Content</h3>
      <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
        <li><a href="/articles/" class="hover:text-indigo-600 dark:hover:text-indigo-400">All Articles</a></li>
        {contentTypes.map((t) => (
          <li><a href={`/${t.slug}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400">{t.name}</a></li>
        ))}
        <li><a href="/tools/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Tool Directory</a></li>
        <li><a href="/calculators/ai-voice-cost/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Cost Calculator</a></li>
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Site</h3>
      <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
        <li><a href="/about/" class="hover:text-indigo-600 dark:hover:text-indigo-400">About</a></li>
        <li><a href="/rss.xml" class="hover:text-indigo-600 dark:hover:text-indigo-400">RSS Feed</a></li>
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Disclosure</h3>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Some links on this site are affiliate links. We may earn a commission
        at no extra cost to you if you buy through them. We only recommend
        tools we've actually researched or used.
      </p>
    </div>
  </div>
  <div class="border-t border-slate-200 px-4 py-4 text-center text-xs text-slate-500 dark:border-slate-800 dark:text-slate-500">
    © {year} CreatorForge. All rights reserved.
  </div>
</footer>
