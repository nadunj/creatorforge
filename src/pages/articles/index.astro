---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="All Articles"
  description="Every guide, comparison, alternative roundup, and pricing breakdown on CreatorForge, newest first."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">All Articles</h1>
    <p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-400">
      Every article on CreatorForge, newest first — guides, comparisons, alternatives, and pricing breakdowns.
    </p>
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </div>
</BaseLayout>
