---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, getCategory } from '../../lib/taxonomy';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<BaseLayout
  title="AI Tool Directory for Creators"
  description="Browse AI tools for YouTube, TikTok, and Facebook creators — voice generators, image tools, video AI, and automation, with pricing and free-tier info."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">AI Tool Directory</h1>
    <p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-400">
      Every tool here has a plain-English writeup: what it's for, what it costs,
      and whether there's a free tier worth using.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <input
        id="tool-search"
        type="search"
        placeholder="Search tools…"
        class="w-full max-w-xs rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:border-indigo-500 focus:outline-none"
      />
      <select id="category-filter" class="rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-3 py-2 text-sm text-slate-900 dark:text-slate-100">
        <option value="">All categories</option>
        {CATEGORIES.map((cat) => <option value={cat.slug}>{cat.name}</option>)}
      </select>
      <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
        <input id="free-only" type="checkbox" class="rounded border-slate-300 dark:border-slate-600" />
        Free tier only
      </label>
    </div>

    <div id="tool-grid" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
        <a
          href={`/tools/${tool.id}/`}
          class="tool-card rounded-xl border border-slate-200 dark:border-slate-700 p-5 transition hover:border-indigo-300 dark:hover:border-indigo-500 hover:shadow-md"
          data-name={tool.data.name.toLowerCase()}
          data-categories={tool.data.categories.join(',')}
          data-free={tool.data.hasFreeTier ? '1' : '0'}
        >
          <div class="mb-2 flex items-center justify-between">
            <h3 class="font-semibold text-slate-900 dark:text-slate-100">{tool.data.name}</h3>
            <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-xs font-medium text-slate-600 dark:text-slate-400">
              {tool.data.pricingModel}
            </span>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-400">{tool.data.description}</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {tool.data.categories.map((slug) => (
              <span class="text-xs text-slate-400 dark:text-slate-500">{getCategory(slug)?.name}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
    <p id="no-results" class="mt-8 hidden text-slate-500 dark:text-slate-400">No tools match those filters.</p>
  </div>

  <script>
    const search = document.getElementById('tool-search') as HTMLInputElement;
    const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
    const freeOnly = document.getElementById('free-only') as HTMLInputElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card'));
    const noResults = document.getElementById('no-results')!;

    function applyFilters() {
      const q = search.value.trim().toLowerCase();
      const cat = categoryFilter.value;
      const onlyFree = freeOnly.checked;
      let visible = 0;

      for (const card of cards) {
        const matchesQuery = !q || card.dataset.name!.includes(q);
        const matchesCategory = !cat || card.dataset.categories!.split(',').includes(cat);
        const matchesFree = !onlyFree || card.dataset.free === '1';
        const show = matchesQuery && matchesCategory && matchesFree;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      noResults.classList.toggle('hidden', visible !== 0);
    }

    search.addEventListener('input', applyFilters);
    categoryFilter.addEventListener('change', applyFilters);
    freeOnly.addEventListener('change', applyFilters);
  </script>
</BaseLayout>
