---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategory } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const tools = await getCollection('tools', ({ data }) => !data.draft);
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.data.name,
  description: tool.data.description,
  applicationCategory: 'MultimediaApplication',
  offers: {
    '@type': 'Offer',
    price: tool.data.hasFreeTier ? '0' : undefined,
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title={`${tool.data.name} Review, Pricing & Alternatives`}
  description={tool.data.description}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-4 flex flex-wrap gap-2">
      {tool.data.categories.map((slug) => {
        const cat = getCategory(slug);
        return cat ? (
          <a href={`/category/${cat.slug}/`} class="rounded-full bg-indigo-50 dark:bg-indigo-500/10 px-2.5 py-0.5 text-xs font-semibold text-indigo-700 dark:text-indigo-300 hover:bg-indigo-100">
            {cat.name}
          </a>
        ) : null;
      })}
    </div>

    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-4xl">{tool.data.name}</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{tool.data.description}</p>

    <div class="mt-6 grid grid-cols-2 gap-4 rounded-xl border border-slate-200 dark:border-slate-700 p-5 sm:grid-cols-4">
      <div>
        <div class="text-xs font-semibold uppercase text-slate-400 dark:text-slate-500">Pricing</div>
        <div class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100 capitalize">{tool.data.pricingModel}</div>
      </div>
      {tool.data.startingPrice && (
        <div>
          <div class="text-xs font-semibold uppercase text-slate-400 dark:text-slate-500">Starting at</div>
          <div class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100">{tool.data.startingPrice}</div>
        </div>
      )}
      <div>
        <div class="text-xs font-semibold uppercase text-slate-400 dark:text-slate-500">Free tier</div>
        <div class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100">{tool.data.hasFreeTier ? 'Yes' : 'No'}</div>
      </div>
      {tool.data.bestFor && (
        <div>
          <div class="text-xs font-semibold uppercase text-slate-400 dark:text-slate-500">Best for</div>
          <div class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100">{tool.data.bestFor}</div>
        </div>
      )}
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={tool.data.affiliateUrl ?? tool.data.website}
        rel={tool.data.affiliateUrl ? 'sponsored noopener' : 'noopener'}
        target="_blank"
        class="rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500"
      >
        Visit {tool.data.name} →
      </a>
    </div>
    {tool.data.affiliateUrl && (
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">This is an affiliate link — we may earn a commission at no extra cost to you.</p>
    )}

    {(tool.data.pros.length > 0 || tool.data.cons.length > 0) && (
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {tool.data.pros.length > 0 && (
          <div>
            <h2 class="mb-2 font-semibold text-slate-900 dark:text-slate-100">Pros</h2>
            <ul class="space-y-1 text-sm text-slate-700 dark:text-slate-300">
              {tool.data.pros.map((p) => <li>+ {p}</li>)}
            </ul>
          </div>
        )}
        {tool.data.cons.length > 0 && (
          <div>
            <h2 class="mb-2 font-semibold text-slate-900 dark:text-slate-100">Cons</h2>
            <ul class="space-y-1 text-sm text-slate-700 dark:text-slate-300">
              {tool.data.cons.map((c) => <li>− {c}</li>)}
            </ul>
          </div>
        )}
      </div>
    )}

    <div class="prose-article mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
