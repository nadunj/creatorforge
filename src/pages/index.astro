---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CONTENT_TYPES, getCategory } from '../lib/taxonomy';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = allArticles;
const sidebarArticles = rest.slice(0, 8);

function typeName(slug: string) {
  return CONTENT_TYPES.find((t) => t.slug === slug)?.name ?? slug;
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'CreatorForge',
    url: Astro.site,
    description:
      'AI tools, tutorials, and comparisons for YouTubers, Facebook and TikTok creators, designers, and small online businesses.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: allArticles.slice(0, 10).map((article, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/${article.id}/`, Astro.site).toString(),
      name: article.data.title,
    })),
  },
];
---

<BaseLayout
  title="CreatorForge — AI Tools & Guides for Content Creators"
  description="Find the best AI tools for YouTube, TikTok, and Facebook creators: voice generators, image tools, video AI, and automation — with honest comparisons and pricing breakdowns."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-indigo-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        The AI toolkit for creators, decoded.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
        Honest guides, comparisons, and pricing breakdowns for the AI voice, video,
        image, and automation tools YouTubers, Facebook creators, and small online
        businesses actually use.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/tools/" class="rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500">
          Browse the Tool Directory
        </a>
        <a href="/guides/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
          Read the Guides
        </a>
      </div>
    </div>
  </section>

  {featured && (
    <section class="mx-auto max-w-6xl px-4 py-14">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-slate-900">Latest from CreatorForge</h2>
        <a href="/guides/" class="text-sm font-semibold text-indigo-600 hover:underline">View all articles →</a>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <article class="lg:col-span-2">
          <a href={`/${featured.id}/`} class="group block overflow-hidden rounded-xl border border-slate-200 transition hover:border-indigo-300 hover:shadow-md">
            {featured.data.image && (
              <img
                src={featured.data.image}
                alt={featured.data.imageAlt ?? featured.data.title}
                class="h-64 w-full object-cover sm:h-80"
                loading="eager"
              />
            )}
            <div class="p-6">
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
                  {typeName(featured.data.type)}
                </span>
                <span class="text-xs font-medium text-slate-400">
                  {featured.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 group-hover:text-indigo-600">
                {featured.data.title}
              </h3>
              <p class="mt-3 text-slate-600">{featured.data.description}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-indigo-600">Read the full article →</span>
            </div>
          </a>
        </article>

        <aside aria-label="More recent articles">
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">More recent articles</h3>
          <ul class="divide-y divide-slate-200 rounded-xl border border-slate-200">
            {sidebarArticles.map((article) => (
              <li>
                <a href={`/${article.id}/`} class="flex flex-col gap-1 p-4 transition hover:bg-slate-50">
                  <span class="text-xs font-semibold text-indigo-600">{typeName(article.data.type)}</span>
                  <span class="font-medium text-slate-900">{article.data.title}</span>
                  <span class="text-xs text-slate-400">
                    {article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="mb-6 text-2xl font-bold text-slate-900">Explore by category</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((cat) => (
        <a
          href={`/category/${cat.slug}/`}
          class="rounded-xl border border-slate-200 p-5 transition hover:border-indigo-300 hover:shadow-md"
        >
          <h3 class="mb-1 font-semibold text-slate-900">{cat.name}</h3>
          <p class="text-sm text-slate-600">{cat.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
