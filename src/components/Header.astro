---
import { getActiveNav } from '../lib/nav-data';

const { categories, contentTypes } = await getActiveNav();
---

<header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100">
      Creator<span class="text-indigo-600 dark:text-indigo-400">Forge</span>
    </a>

    <nav class="hidden items-center gap-5 text-sm font-medium text-slate-700 dark:text-slate-300 lg:flex">
      <a href="/tools/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Tools</a>
      {contentTypes.map((t) => (
        <a href={`/${t.slug}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400">{t.name}</a>
      ))}
      <div class="group relative">
        <button class="flex items-center gap-1 hover:text-indigo-600 dark:hover:text-indigo-400">
          Categories
          <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.19l3.71-3.96a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
        </button>
        <div class="invisible absolute left-0 z-10 grid w-64 grid-cols-1 gap-1 rounded-lg border border-slate-200 bg-white p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 dark:border-slate-700 dark:bg-slate-800">
          {categories.map((cat) => (
            <a href={`/category/${cat.slug}/`} class="rounded-md px-3 py-2 text-sm hover:bg-slate-50 hover:text-indigo-600 dark:hover:bg-slate-700 dark:hover:text-indigo-400">
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <a
      href="/tools/"
      class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-400"
    >
      Browse Tools
    </a>
  </div>
</header>
